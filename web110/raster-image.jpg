<svg xmlns="http://www.w3.org/2000/svg" width="200" height="200" viewBox="0 0 200 200">
  <!-- Background Grid Frame -->
  <rect width="200" height="200" fill="#f0f0f0" stroke="#ccc" stroke-width="2" />
  
  <!-- Simulated Raster Pixel Blocks -->
  <rect x="20" y="20" width="40" height="40" fill="#ff4d4d" />
  <rect x="60" y="20" width="40" height="40" fill="#ff9933" />
  <rect x="100" y="20" width="40" height="40" fill="#ffff4d" />
  <rect x="140" y="20" width="40" height="40" fill="#4dff4d" />
  
  <rect x="20" y="60" width="40" height="40" fill="#3399ff" />
  <rect x="60" y="60" width="40" height="40" fill="#9933ff" />
  <rect x="100" y="60" width="40" height="40" fill="#ff3399" />
  <rect x="140" y="60" width="40" height="40" fill="#33ffff" />

  <!-- Label -->
  <text x="100" y="145" font-family="sans-serif" font-size="18" font-weight="bold" text-anchor="middle" fill="#333">Raster Grid</text>
  <text x="100" y="170" font-family="sans-serif" font-size="12" text-anchor="middle" fill="#666">(Pixel-Based)</text>
</svg>
